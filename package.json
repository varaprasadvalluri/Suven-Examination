    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "opossum": "^5.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-react": "^5.32.14",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
