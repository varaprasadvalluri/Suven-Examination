{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.server.json server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --tsconfig=tsconfig.server.json --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "trace:viewer": "node scripts/trace-viewer.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "eslint": "eslint .",
    "lint:cycles": "madge --extensions ts,tsx --circular src server",
    "eslint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --tsconfig tsconfig.server.json migrate-db.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "android:sync": "vite build && npx cap sync android",
    "android:sync:local": "./scripts/android-sync-local.sh",
    "android:open": "npx cap open android",
    "android:keystore": "./scripts/android-generate-keystore.sh",
    "android:build:apk": "./scripts/android-build.sh apk",
    "android:build:aab": "./scripts/android-build.sh aab",
    "ios:sync": "vite build && npx cap sync ios",
    "ios:sync:local": "CAP_ENV=local vite build && CAP_ENV=local npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "./scripts/ios-archive.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.1.0",
    "@google-cloud/tasks": "^7.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "opossum": "^5.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-react": "^5.32.14",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.11",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
