VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase project config — the single source of truth for both the server AND the frontend
# build (vite.config.ts bakes these into the client bundle at build time, so the frontend
# needs them present whenever you run `npm run build` / `npm run dev`, not just the server).
# Values are Firebase's public *web* config (safe to expose — same as any Firebase web app
# ships in its JS bundle); the actual Firestore access uses separate ADC/service-account
# credentials that never appear here. Find these in Firebase Console > Project Settings.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Signing key for app session tokens (JWT). Required in any real deployment — if unset the
# server generates a random one at boot, which invalidates all sessions on every restart
# and breaks multi-instance deployments (each instance would sign with a different key).
# Generate with: openssl rand -hex 48
JWT_SECRET=

# Only needed when running load-test.cjs against this server. Gates the load-test session
# bypass in /api/gatekeeper/enroll — leave unset in production so that bypass stays fully
# disabled. Set the same value here and wherever you invoke load-test.cjs from.
LOAD_TEST_SECRET=

# Real admin email granted automatic admin status for "school-1" by /api/db/seed. Falls back
# to a non-real demo address if unset — set this to your own address before seeding, never
# check in a real person's email here.
SEED_SCHOOL1_ADMIN_EMAIL=

# Fallback identities for /api/gcp/sync-iam and /api/gcp/live-billing admin-only diagnostics
# when no staff exist in Firestore yet. Never check in a real person's email here.
PRIMARY_ADMIN_EMAIL=
OPERATIONS_ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis configuration for DigitalOcean 10k student scaling & health diagnostics
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Cloud Tasks config for async exam-grading (server/lib/taskQueue.ts). All four optional —
# leave unset for local dev; exam submission grades inline instead of via a real queue.
# Required for real deployments at scale (see server/lib/taskQueue.ts for what each does):
#   GCP_LOCATION            Region the Cloud Tasks queue lives in, e.g. us-central1
#   CLOUD_TASKS_QUEUE       Queue name, e.g. exam-grading-queue
#   CLOUD_TASKS_INVOKER_SA  Service account email used to sign the OIDC token on each task
#   CLOUD_RUN_SERVICE_URL   This service's own public URL, e.g. https://your-service-xyz.run.app
GCP_LOCATION=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_INVOKER_SA=
CLOUD_RUN_SERVICE_URL=
