VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase project config — the single source of truth for both the server AND the frontend
# build (vite.config.ts bakes these into the client bundle at build time, so the frontend
# needs them present whenever you run `npm run build` / `npm run dev`, not just the server).
# Values are Firebase's public *web* config (safe to expose — same as any Firebase web app
# ships in its JS bundle); the actual Firestore access uses separate ADC/service-account
# credentials that never appear here. Find these in Firebase Console > Project Settings.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Signing key for app session tokens (JWT). Required in any real deployment — if unset the
# server generates a random one at boot, which invalidates all sessions on every restart
# and breaks multi-instance deployments (each instance would sign with a different key).
# Generate with: openssl rand -hex 48
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis configuration for DigitalOcean 10k student scaling & health diagnostics
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
