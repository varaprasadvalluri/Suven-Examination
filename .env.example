VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase project the server talks to. Optional if firebase-applet-config.json is present
# (it's checked in for the frontend build, which needs it regardless) — these env vars
# override that file when set, so a deployment can point at a different project/key without
# a code change. Recommended for production so the value isn't duplicated across environments.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_API_KEY=

# Signing key for app session tokens (JWT). Required in any real deployment — if unset the
# server generates a random one at boot, which invalidates all sessions on every restart
# and breaks multi-instance deployments (each instance would sign with a different key).
# Generate with: openssl rand -hex 48
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis configuration for DigitalOcean 10k student scaling & health diagnostics
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
